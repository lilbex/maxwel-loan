# Runtime connection. This role must not be a superuser and must not have BYPASSRLS.
# The API refuses to start if it does.
DATABASE_URL=postgres://loan_app:loan_app_dev@localhost:5432/loan_platform

# Used only for migrations and tenant provisioning. Never give this to the running API.
MIGRATOR_DATABASE_URL=postgres://loan_migrator:loan_migrator_dev@localhost:5432/loan_platform

PORT=4000
SESSION_TTL_HOURS=12
# Set to true everywhere except local HTTP development.
COOKIE_SECURE=false
# Proxy addresses Express should trust for the client IP. Next.js proxies /api in development.
TRUST_PROXY=loopback
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Daily penalty job. Needs the Redis container from docker-compose.yml.
REDIS_URL=redis://localhost:6379
JOBS_ENABLED=true

# Used by the Next.js app.
API_URL=http://localhost:4000
